{
  "name": "zusound",
  "version": "0.2.5",
  "description": "Hear bugs before you see them - audio debugging for Zustand",
  "keywords": [
    "zustand",
    "middleware",
    "audio",
    "debugging",
    "state-management",
    "sound",
    "developer-experience"
  ],
  "homepage": "https://github.com/joe-byounghern-kim/zusound",
  "bugs": "https://github.com/joe-byounghern-kim/zusound/issues",
  "repository": "joe-byounghern-kim/zusound",
  "license": "MIT",
  "author": "joe-byounghern-kim",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist coverage",
    "dev": "tsup --watch",
    "lint": "eslint src __tests__ tsup.config.ts vitest.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "zustand": ">=4.0.0 <6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "zustand": "^5.0.15"
  }
}
