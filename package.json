{
  "name": "zusound-monorepo",
  "private": true,
  "description": "Zusound - Audio feedback middleware for Zustand",
  "repository": {
    "type": "git",
    "url": "https://github.com/joe-byounghern-kim/zusound.git"
  },
  "license": "MIT",
  "author": "joe-byounghern-kim",
  "type": "module",
  "workspaces": [
    "packages/zusound",
    "examples"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:watch": "turbo run build:watch",
    "changeset": "changeset",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:artifacts": "node scripts/clean-local-artifacts.mjs",
    "dev": "turbo run dev",
    "demo:stage": "pnpm build && pnpm -C demo run stage",
    "demo:stage:clean": "pnpm -C demo run clean-stage",
    "demo:verify": "pnpm -C demo run check-stage",
    "demo:preview": "python3 -m http.server 4173 --directory demo/dist-site",
    "demo:react:dev": "pnpm -C examples dev",
    "demo:react:build": "pnpm -C examples build",
    "demo:react:typecheck": "pnpm -C examples typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml}\"",
    "lint": "turbo run lint",
    "prepare": "husky install",
    "readme:check": "node scripts/sync-readme.mjs --check",
    "readme:sync": "node scripts/sync-readme.mjs",
    "skills:bridge": "node scripts/build-skill-bridge.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "skills:validate": "pnpm skills:check",
    "publish:package": "npm publish --workspace=packages/zusound",
    "release": "turbo run build && changeset publish",
    "release:auto:prepare": "node scripts/create-auto-changeset.mjs && pnpm version-packages",
    "release:auto:dry-run": "node scripts/create-auto-changeset.mjs --dry-run",
    "test": "turbo run test",
    "test:clean-artifacts": "node --test scripts/clean-local-artifacts.test.mjs",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "turbo": "^2.9.14",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "0.28.1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
